<Project Sdk="Microsoft.NET.Sdk">

  <!-- The database, central, login and map spawn servers as one .NET program, built from the
       kit's Server/, Database/ and SharedData/. Map servers still need a Unity build.
       Derived from suriyun-mmorpg/UnityMultiplayerARPG_MMO.NET (MIT). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenMMORPG.MMO.NET</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(KitDir)Server\**\*.cs" Link="Kit\Server\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(KitDir)Database\**\*.cs" Link="Kit\Database\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(KitDir)SharedData\**\*.cs" Link="Kit\SharedData\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(KitDir)ThirdParty\DevExtension\**\*.cs" Link="Kit\DevExtension\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(HostsThirdPartyDir)LiteNetLibManager\**\*.cs" Link="ThirdParty\LiteNetLibManager\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(HostsThirdPartyDir)RestClient\**\*.cs" Link="ThirdParty\RestClient\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.23" />
    <!-- Pinned above what the packages ask for, to clear NuGet audit advisories:
         the SQLite native library (via Microsoft.Data.Sqlite) and System.Text.Json (via ZLogger) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Text.Json" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.8" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.11" />
    <PackageReference Include="UniTask" Version="2.5.10" />
    <PackageReference Include="ZLogger" Version="1.7.1" />
    <PackageReference Include="ZString" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
