{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  /* Plain HTTP for local use. For anything public, put it behind TLS (a reverse proxy, or an
     https:// URL here with a certificate configured for Kestrel) and change ApiSecretKey. */
  "Urls": "http://localhost:5757",
  "CacheManager": 0, /* 0 = Local, 1 = Redis (Config/redisConfig.json) */
  "DatabaseServer": 1, /* 0 = MySQL, 1 = SQLite, 2 = PostgreSQL (Config/*.json) */
  "UserLoginManager": 0, /* 0 = Default */
  "UserLoginManagerConfig": {
    "PasswordSaltPrefix": "",
    "PasswordSaltPostfix": "",
    "PasswordHashIterations": 1000 /* rounds of the password hash; use the servers' passwordHashIterations */
  },
  "ApiSecretKey": "secret"
}
