<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The database tier as an ASP.NET Core web API, built from the kit's Database/ and
       SharedData/. Game servers reach it through RestDatabaseClient (useCustomDatabaseClient).
       Derived from suriyun-mmorpg/UnityMultiplayerARPG_DatabaseManager (MIT). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenMMORPG.DatabaseManager</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(KitDir)Database\**\*.cs" Link="Kit\Database\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(KitDir)SharedData\**\*.cs" Link="Kit\SharedData\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(KitDir)ThirdParty\DevExtension\**\*.cs" Link="Kit\DevExtension\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(HostsThirdPartyDir)LiteNetLibManager\**\*.cs" Link="ThirdParty\LiteNetLibManager\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConcurrentHashSet" Version="1.3.0" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- Pinned above what Microsoft.Data.Sqlite asks for, to clear a NuGet audit advisory on
         the SQLite native library -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="2.9.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="UniTask" Version="2.5.10" />
    <PackageReference Include="ZLogger" Version="1.7.1" />
    <PackageReference Include="ZString" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config/, the folder the code reads (./Config/...). Upstream ships it as config/, which
         only matches on case-insensitive file systems. -->
    <Content Update="Config\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
